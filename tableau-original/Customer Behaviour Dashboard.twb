    <worksheet name='Region - Sales Per Customer (CY Vs PY)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Bold' fontsize='14'>Region - Sales Per Customer (CY Vs PY)</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontsize='12'>This butterfly chart shows a comparison of sales CY and PY per customer. It is split into Region.In this book is the category where maximum sales is visible.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retail_Customer_Behavior1' name='federated.0grsuiz1pq2l9q1cab8hj09ftqxp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2024'>
              <calculation class='tableau' formula='2024' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0grsuiz1pq2l9q1cab8hj09ftqxp'>
            <column caption='PY Customers' datatype='string' name='[CY Customers (copy)_972496082264174592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Purchase_Date]) = [Parameters].[Parameter 1]-1 &#13;&#10;THEN [Customer_ID] &#13;&#10;END' />
            </column>
            <column caption='PY Sales Per Customer' datatype='real' name='[CY Sales Per Customer (copy)_972496082285047812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Current Year (Sales) (copy)_256142266204172292])/COUNTD([CY Customers (copy)_972496082264174592])' />
            </column>
            <column caption='Current Year (Sales)' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_256142266203430915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Purchase_Date]) = [Parameters].[Parameter 1] THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='CY Customers' datatype='string' name='[Calculation_256142266422910997]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  YEAR([Purchase_Date]) = [Parameters].[Parameter 1] &#13;&#10;THEN [Customer_ID] &#13;&#10;END' />
            </column>
            <column caption='CY Sales Per Customer' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_972496082284814339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_256142266203430915])/COUNTD([Calculation_256142266422910997])' />
            </column>
            <column caption='Previous Year (Sales)' datatype='real' default-format='n&quot;$&quot;0,K;-&quot;$&quot;0,K' name='[Current Year (Sales) (copy)_256142266204172292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Purchase_Date]) = [Parameters].[Parameter 1]-1 THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='Customer ID' datatype='string' name='[Customer_ID]' role='dimension' type='nominal' />
            <column caption='Product Category' datatype='string' name='[Product_Category]' role='dimension' type='nominal' />
            <column caption='Purchase Date' datatype='date' name='[Purchase_Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Region]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <semantic-values semantic-role='[Country].[Name]'>
                <semantic-value key='&quot;East&quot;' value='&quot;USA&quot;' />
                <semantic-value key='&quot;North&quot;' value='&quot;USA&quot;' />
                <semantic-value key='&quot;South&quot;' value='&quot;USA&quot;' />
                <semantic-value key='&quot;West&quot;' value='&quot;USA&quot;' />
              </semantic-values>
