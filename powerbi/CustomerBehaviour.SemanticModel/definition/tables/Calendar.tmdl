table Calendar
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month No'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month No]

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month No'

	partition Calendar = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( DATE ( 2022, 1, 1 ), DATE ( 2024, 12, 31 ) ), "Year", YEAR ( [Date] ), "Month No", MONTH ( [Date] ), "Month", FORMAT ( [Date], "mmm" ) )

